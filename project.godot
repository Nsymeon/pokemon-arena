config_version=5

[application]
config/name="Pokémon • Arena Prototype"
run/main_scene="res://arena.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=960
window/size/window_width_override=1120
window/size/window_height_override=840
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.065, 0.09, 1)
